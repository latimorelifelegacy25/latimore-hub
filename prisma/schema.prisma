
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PipelineStage {
  New
  Attempted_Contact
  Qualified
  Booked
  Sold
  Follow_Up
  Lost
}

enum ProductInterest {
  Mortgage_Protection
  Final_Expense
  Term_Life
  Whole_Life
  Child_Whole_Life
  Accident
  Critical_Illness
  IUL
  Annuity
  Retirement
  Business
  General
}

enum EventType {
  page_view
  cta_click
  call_click
  text_click
  email_click
  book_click
  form_submit
  lead_created
  appointment_booked
  stage_changed
  county_selected
  product_selected
  lead_magnet_download
}

enum ThreadChannel {
  sms
  email
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  queued
  sent
  delivered
  failed
  received
  opened
  clicked
  bounced
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed
}

enum AiRunType {
  daily_brief
  draft_message
  contact_brief
  lead_score
  content_generation
}

enum ContentType {
  sms
  email
  social_post
  blog
  landing_page
}

enum ContentStatus {
  draft
  approved
  scheduled
  published
  archived
}

enum CalendarProvider {
  calendly
  google
  outlook
  manual
}

enum CalendarEventStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
  rescheduled
}

model LeadSession {
  id              String            @id
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  firstSeenAt     DateTime          @default(now())
  lastSeenAt      DateTime          @default(now())
  landingPage     String?
  referrer        String?
  source          String?
  medium          String?
  campaign        String?
  term            String?
  content         String?
  county          String?
  productInterest ProductInterest?
  contactId       String?
  contact         Contact?          @relation(fields: [contactId], references: [id])
  inquiries       Inquiry[]
  events          Event[]
  systemEvents    SystemEvent[]

  @@index([source, medium, campaign])
  @@index([county])
  @@index([contactId])
}

model Contact {
  id                    String                @id @default(uuid())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  email                 String?               @unique
  firstName             String?
  lastName              String?
  fullName              String?
  phone                 String?
  county                String?
  primarySource         String?
  primaryMedium         String?
  primaryCampaign       String?
  leadScore             Int                   @default(0)
  lastActivityAt        DateTime?
  nextFollowUpAt        DateTime?
  notesSummary          String?
  leadSessions          LeadSession[]
  inquiries             Inquiry[]
  appointments          Appointment[]
  tasks                 Task[]
  events                Event[]
  notes                 Note[]
  conversationThreads   ConversationThread[]
  conversationMessages  ConversationMessage[]
  systemEvents          SystemEvent[]
  aiRuns                AiRun[]
  emailLogs             EmailLog[]
  calendarEvents        CalendarEvent[]

  @@index([county])
  @@index([phone])
  @@index([leadScore])
  @@index([lastActivityAt])
}

model Inquiry {
  id              String                @id @default(uuid())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  contactId       String
  contact         Contact               @relation(fields: [contactId], references: [id])
  leadSessionId   String?
  leadSession     LeadSession?          @relation(fields: [leadSessionId], references: [id])
  stage           PipelineStage         @default(New)
  productInterest ProductInterest       @default(General)
  source          String?
  medium          String?
  campaign        String?
  landingPage     String?
  county          String?
  notes           String?
  leadScore       Int                   @default(0)
  appointments    Appointment[]
  tasks           Task[]
  history         InquiryStageHistory[]
  events          Event[]
  notesEntries    Note[]
  systemEvents    SystemEvent[]
  aiRuns          AiRun[]
  calendarEvents  CalendarEvent[]

  @@index([stage])
  @@index([productInterest])
  @@index([source, medium, campaign])
  @@index([county])
  @@index([contactId])
  @@index([leadScore])
}

model Appointment {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id])
  inquiryId      String?
  inquiry        Inquiry?         @relation(fields: [inquiryId], references: [id])
  bookingSource  String?
  source         String?
  medium         String?
  campaign       String?
  scheduledFor   DateTime?
  status         String           @default("Booked")
  location       String?
  calendlyEventId String?
  metadata       Json?
  calendarEvents CalendarEvent[]

  @@index([scheduledFor])
  @@index([status])
}

model Task {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String
  description String?
  status      String    @default("Open")
  dueAt       DateTime?
  inquiryId   String?
  inquiry     Inquiry?  @relation(fields: [inquiryId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])

  @@index([status])
  @@index([dueAt])
}

model Event {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  eventType       EventType
  contactId       String?
  contact         Contact?         @relation(fields: [contactId], references: [id])
  inquiryId       String?
  inquiry         Inquiry?         @relation(fields: [inquiryId], references: [id])
  leadSessionId   String?
  leadSession     LeadSession?     @relation(fields: [leadSessionId], references: [id])
  pageUrl         String?
  referrer        String?
  source          String?
  medium          String?
  campaign        String?
  county          String?
  productInterest ProductInterest?
  metadata        Json?
  occurredAt      DateTime         @default(now())

  @@index([eventType, occurredAt])
  @@index([source, medium, campaign])
  @@index([county])
  @@index([contactId])
  @@index([inquiryId])
  @@index([leadSessionId])
}

model SystemEvent {
  id            String              @id @default(uuid())
  createdAt     DateTime            @default(now())
  occurredAt    DateTime            @default(now())
  type          String
  contactId     String?
  contact       Contact?            @relation(fields: [contactId], references: [id])
  inquiryId     String?
  inquiry       Inquiry?            @relation(fields: [inquiryId], references: [id])
  leadSessionId String?
  leadSession   LeadSession?        @relation(fields: [leadSessionId], references: [id])
  threadId      String?
  thread        ConversationThread? @relation(fields: [threadId], references: [id])
  source        String?
  medium        String?
  campaign      String?
  payload       Json
  metadata      Json?

  @@index([type, occurredAt])
  @@index([contactId])
  @@index([inquiryId])
}

model ConversationThread {
  id             String                @id @default(uuid())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  contactId      String
  contact        Contact               @relation(fields: [contactId], references: [id])
  inquiryId      String?
  inquiry        Inquiry?              @relation(fields: [inquiryId], references: [id])
  channel        ThreadChannel
  externalId     String?
  subject        String?
  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  isArchived     Boolean               @default(false)
  messages       ConversationMessage[]
  systemEvents   SystemEvent[]

  @@index([contactId, updatedAt])
  @@index([channel])
}

model ConversationMessage {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  threadId          String
  thread            ConversationThread @relation(fields: [threadId], references: [id])
  contactId         String?
  contact           Contact?           @relation(fields: [contactId], references: [id])
  inquiryId         String?
  inquiry           Inquiry?           @relation(fields: [inquiryId], references: [id])
  direction         MessageDirection
  channel           ThreadChannel
  status            MessageStatus?
  subject           String?
  bodyText          String?
  providerMessageId String?
  fromAddress       String?
  toAddress         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  metadata          Json?

  @@index([threadId, createdAt])
  @@index([contactId])
}

model AiRun {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  type        AiRunType
  status      AiRunStatus @default(queued)
  model       String?
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id])
  inquiryId   String?
  inquiry     Inquiry?    @relation(fields: [inquiryId], references: [id])
  input       Json
  output      Json?
  tokensInput Int?
  tokensOutput Int?
  latencyMs   Int?
  error       String?

  @@index([type, createdAt])
  @@index([status])
  @@index([contactId])
}

model Note {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  inquiryId   String?
  inquiry     Inquiry?  @relation(fields: [inquiryId], references: [id])
  title       String?
  body        String
  author      String?
  isPinned    Boolean   @default(false)

  @@index([contactId, createdAt])
  @@index([inquiryId, createdAt])
}

model InquiryStageHistory {
  id         String         @id @default(uuid())
  changedAt  DateTime       @default(now())
  inquiryId  String
  inquiry    Inquiry        @relation(fields: [inquiryId], references: [id])
  fromStage  PipelineStage?
  toStage    PipelineStage
  actor      String?
  note       String?

  @@index([inquiryId, changedAt])
}

model EmailLog {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id])
  toAddr     String
  fromAddr   String
  subject    String
  template   String?
  status     String
  providerId String?
  error      String?

  @@index([contactId])
  @@index([status])
}

model ContentAsset {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  title           String
  type            ContentType
  status          ContentStatus    @default(draft)
  channel         String?
  audience        String?
  campaign        String?
  productInterest ProductInterest?
  prompt          String?
  bodyText        String?
  bodyHtml        String?
  metadata        Json?
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdBy       String?

  @@index([type, status])
  @@index([campaign])
  @@index([scheduledFor])
}

model CalendarConnection {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  provider        CalendarProvider
  accountEmail    String?
  externalId      String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  metadata        Json?

  @@index([provider])
}

model CalendarEvent {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  contactId      String?
  contact        Contact?             @relation(fields: [contactId], references: [id])
  inquiryId      String?
  inquiry        Inquiry?             @relation(fields: [inquiryId], references: [id])
  appointmentId  String?
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id])
  provider       CalendarProvider
  externalId     String?
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime?
  timezone       String?
  location       String?
  meetingUrl     String?
  status         CalendarEventStatus  @default(scheduled)
  payload        Json?

  @@index([provider, externalId])
  @@index([contactId])
  @@index([startAt])
  @@index([status])
}
